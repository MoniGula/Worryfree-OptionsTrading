# Copy this file to .env and fill in your real Alpaca paper-trading
# credentials. Never commit .env to source control.

API_KEY=your_alpaca_api_key_here
API_SECRET=your_alpaca_api_secret_here

# Optional: override the default paper-trading base URL
# BASE_URL=https://paper-api.alpaca.markets

# --- Strategy parameters (all optional; sane defaults are used if unset) ---

# Comma-separated list of underlyings to scan each run.
# UNDERLYING_SYMBOLS=SPY,QQQ,AAPL,MSFT,AMD,NVDA,TSLA

# Days-to-expiry window for new positions (short-dated weeklies).
# MIN_DAYS_TO_EXPIRY=2
# MAX_DAYS_TO_EXPIRY=5

# Absolute delta target for the short strike of a credit spread.
# TARGET_DELTA=0.20

# Maximum notional risk (max loss) allowed per trade, in USD.
# MAX_POSITION_SIZE=2000

# Maximum fraction of account equity allowed as collateral across all
# open positions at once (portfolio-level risk gate).
# MAX_PORTFOLIO_COLLATERAL_PCT=0.65

# Fraction of max profit at which an open position is closed early to
# recycle capital instead of holding to expiry.
# PROFIT_TAKE_PCT=0.60

# Minimum number of calendar days before an earnings event required to
# open a new position (earnings risk gate).
# MIN_DAYS_TO_EARNINGS=3
